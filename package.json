{
  "name": "voiceprotokoll-guard",
  "version": "0.1.0",
  "description": "WhatsApp-Sprachnachricht → Protokoll-E-Mail + Archiv + Gewährleistungs-Tracking für Handwerker. Keine App, kein Login.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:ki": "tsx src/test-ki.ts",
    "test:demo": "tsx src/test-demo.ts",
    "test:transkript": "tsx src/test-transkript.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.48.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
