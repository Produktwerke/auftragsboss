# ── Server ────────────────────────────────────────────────
PORT=3000
# Öffentlich erreichbare Adresse — landet in den Links, die per WhatsApp
# und E-Mail verschickt werden. Lokal einfach weglassen.
# BASE_URL=https://angebotsblitz.de

# Geheimer Zugang zur internen Lern-Auswertung unter /admin/<TOKEN>.
# Nur setzen, wenn die Auswertung erreichbar sein soll (sonst 404). Lang und
# zufällig wählen — enthält echte Kundendaten!
# ADMIN_TOKEN=

# ── Datenbank (SQLite für Dev; für Prod: postgresql://...) ─
DATABASE_URL="file:./dev.db"

# ── Anthropic (Strukturierung des Transkripts) ────────────
# https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (Whisper-Transkription der Sprachnachricht) ────
# https://platform.openai.com → API Keys
OPENAI_API_KEY=sk-...

# ── Meta WhatsApp Cloud API ───────────────────────────────
# https://developers.facebook.com → App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Frei wählbarer String — muss identisch in der Meta-Webhook-Konfiguration stehen
WHATSAPP_VERIFY_TOKEN=vpg-webhook-2026

# ── E-Mail-Versand (SMTP — funktioniert mit IONOS, Strato, Gmail etc.) ─
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=protokoll@meinefirma.de
SMTP_PASS=geheim
SMTP_FROM="VoiceProtokoll Guard <protokoll@meinefirma.de>"
