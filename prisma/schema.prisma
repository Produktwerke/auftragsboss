// Angebotsblitz — Datenmodell
// SQLite für Dev; für Produktion provider auf "postgresql" ändern.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Der registrierte Handwerksbetrieb. Identifikation NUR über die
// WhatsApp-Nummer — kein Login, kein Passwort (Kernprinzip!).
model Handwerker {
  id             String     @id @default(cuid())
  whatsappNummer String     @unique // E.164, z.B. "4917612345678"
  name           String
  firma          String
  email          String // Zieladresse für die fertigen Dokumente
  gewerk         String?
  erstelltAm     DateTime   @default(now())
  dokumente      Dokument[]
  vorgaenge      Vorgang[]
}

// Ein laufender WhatsApp-Dialog. Bleibt offen, solange die KI noch
// Pflichtangaben vermisst — dann stellt sie Rückfragen, die der Handwerker
// per Sprache oder Text beantwortet. Abgeschlossen wird durch:
//   • Vollständigkeit    • Stichwort ("weiter", "später", "fertig")
//   • maximale Rundenzahl • Zeitablauf (Inaktivität)
model Vorgang {
  id           String     @id @default(cuid())
  handwerkerId String
  handwerker   Handwerker @relation(fields: [handwerkerId], references: [id])

  status String @default("OFFEN") // "OFFEN" | "ABGESCHLOSSEN"
  runde  Int    @default(0) // Anzahl bereits gestellter Rückfrage-Runden

  // JSON: [{ rolle: "handwerker"|"assistent", text, art, zeit }]
  nachrichtenJson String @default("[]")

  dokumentId String? // gesetzt, sobald das Dokument erzeugt wurde

  begonnenAm       DateTime @default(now())
  letzteAktivitaet DateTime @default(now())

  @@index([handwerkerId, status])
  @@index([status, letzteAktivitaet])
}

// Ein Dokument aus einem Diktat — Angebot ODER Protokoll.
// Beides landet im selben Archiv: der Auftragszyklus eines Kunden
// bleibt so an einer Stelle nachvollziehbar.
model Dokument {
  id           String     @id @default(cuid())
  handwerkerId String
  handwerker   Handwerker @relation(fields: [handwerkerId], references: [id])

  art    String // "ANGEBOT" | "PROTOKOLL"
  nummer String // z.B. "ANG-2026-0042" bzw. "PRO-2026-0042"

  // Nachträge behalten die Angebotsnummer und zählen die Fassung hoch.
  // Die alte Fassung bleibt im Archiv — wichtig für die Nachvollziehbarkeit.
  version  Int     @default(1)
  ersetztId String? // Dokument-ID der vorherigen Fassung

  // Zwei getrennte Links, beide ohne Login (Zufallstoken).
  //   bearbeitenToken → der Handwerker, darf ändern und exportieren
  //   kundenToken     → der Kunde, sieht nur und kann annehmen
  bearbeitenToken String @unique
  kundenToken     String @unique

  // Annahme durch den Kunden. Ein Klick auf "Annehmen" ist ein Vertrags-
  // schluss, deshalb wird der Vorgang beweissicher festgehalten und das
  // Dokument danach eingefroren (Änderungen erzeugen eine neue Fassung).
  angenommenAm   DateTime?
  angenommenVon  String? // Name, den der Kunde angegeben hat
  angenommenIp   String?
  eingefroren    Boolean   @default(false)

  // Rückfragen des Kunden über die Angebotsseite
  kundenRueckfrage   String?
  kundenRueckfrageAm DateTime?

  // Rohdaten — bewusst aufbewahrt (Nachvollziehbarkeit / Streitfall)
  whatsappMediaId String?
  transkript      String // Whisper-Rohtranskript, unverändert

  // Strukturierte Daten (von Claude extrahiert)
  kundeName      String?
  kundeAdresse   String?
  gewerk         String?
  objekt         String?
  positionenJson String // JSON: berechnete Positionen inkl. Preise
  aufmassNotizen String?
  besonderheiten String?
  folgetermin    String?
  einleitung     String
  schlusstext    String
  rueckfragenJson String @default("[]")

  // Summen — im Code berechnet, nicht von der KI
  netto       Float
  mwstSatz    Float
  mwstBetrag  Float
  brutto      Float
  anzahlOffen Int     @default(0) // Positionen ohne Preis
  gueltigBis  DateTime?

  datum      DateTime @default(now())
  erstelltAm DateTime @default(now())

  gewaehrleistung Gewaehrleistung?

  @@index([handwerkerId, datum])
  @@index([art])
  @@index([nummer])
  @@index([angenommenAm])
}

// Gewährleistungs-Tracking nach § 634a BGB — nur für Protokolle:
//   - 2 Jahre für Werkleistungen (Standard)
//   - 5 Jahre für Arbeiten an Bauwerken
// Erinnerung 3 Monate vor Ablauf = Wartungs-Verkaufschance,
// Erinnerung bei Ablauf = Haftungsende dokumentiert.
model Gewaehrleistung {
  id         String   @id @default(cuid())
  dokumentId String   @unique
  dokument   Dokument @relation(fields: [dokumentId], references: [id])

  typ    String // "WERK_2_JAHRE" | "BAUWERK_5_JAHRE"
  beginn DateTime
  ablauf DateTime
  vorwarnung DateTime

  vorwarnungGesendet Boolean @default(false)
  ablaufGesendet     Boolean @default(false)

  @@index([vorwarnung, vorwarnungGesendet])
  @@index([ablauf, ablaufGesendet])
}
