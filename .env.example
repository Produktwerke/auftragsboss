# ── Server ────────────────────────────────────────────────
PORT=3000
# Öffentlich erreichbare Adresse — landet in den Links, die per WhatsApp
# und E-Mail verschickt werden. Lokal einfach weglassen.
# BASE_URL=https://angebotsblitz.de

# Geheimer Zugang zur internen Lern-Auswertung unter /admin/<TOKEN>.
# Nur setzen, wenn die Auswertung erreichbar sein soll (sonst 404). Lang und
# zufällig wählen — enthält echte Kundendaten!
# ADMIN_TOKEN=

# ── Datenbank (SQLite für Dev; für Prod: postgresql://...) ─
DATABASE_URL="file:./dev.db"

# ── Anthropic (Strukturierung des Transkripts) ────────────
# https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (Whisper-Transkription der Sprachnachricht) ────
# https://platform.openai.com → API Keys
OPENAI_API_KEY=sk-...

# ── Meta WhatsApp Cloud API ───────────────────────────────
# https://developers.facebook.com → App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Frei wählbarer String — muss identisch in der Meta-Webhook-Konfiguration stehen
WHATSAPP_VERIFY_TOKEN=vpg-webhook-2026
# App-Secret aus Meta (App-Einstellungen → Grundlegendes). Sobald gesetzt, wird
# jede eingehende Webhook-Anfrage per Signatur geprüft — nur dann akzeptiert der
# Server sie. Für den Echtbetrieb dringend setzen.
# WHATSAPP_APP_SECRET=

# ── Test-Funktion "Direkt testen" ────────────────────────
# Schickt ein Interessent von der Landingpage aus eine Sprachnachricht an unsere
# Nummer, bekommt er ein kostenloses Beispiel-Angebot. Standardmäßig AUS.
# Zum Scharfschalten auf "true" setzen. Alle Grenzen sind optional (Vorgaben unten).
DIREKTTEST_AKTIV=false
# Gratis-Angebote pro Nummer, danach Einladung zur Anmeldung
DIREKTTEST_GRATIS_ANGEBOTE=2
# Harte Obergrenze verarbeiteter Nachrichten pro Nummer (Missbrauchsschutz)
DIREKTTEST_MAX_NACHRICHTEN=12
# Tages-Gesamtdeckel über alle Nummern (Kostenobergrenze)
DIREKTTEST_MAX_PRO_TAG=80
# Mindestabstand zwischen zwei Nachrichten derselben Nummer (Sekunden)
DIREKTTEST_MIN_ABSTAND_SEKUNDEN=3

# ── E-Mail-Versand (SMTP — funktioniert mit IONOS, Strato, Gmail etc.) ─
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=protokoll@meinefirma.de
SMTP_PASS=geheim
SMTP_FROM="VoiceProtokoll Guard <protokoll@meinefirma.de>"
