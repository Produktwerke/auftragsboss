# --- Server -------------------------------------------------
PORT=
# Oeffentlich erreichbare Adresse - landet in den Links, die per WhatsApp
# und E-Mail verschickt werden. Lokal einfach weglassen.
# BASE_URL=

# Geheimer Zugang zur internen Lern-Auswertung unter /admin/<TOKEN>.
# Nur setzen, wenn die Auswertung erreichbar sein soll (sonst 404). Lang und
# zufaellig waehlen - enthaelt echte Kundendaten!
# ADMIN_TOKEN=

# --- Datenbank (SQLite fuer Dev; fuer Prod: postgresql://...) ---
DATABASE_URL=

# --- Anthropic (Strukturierung des Transkripts) ------------
# über gmail eingeloggt (beermit2e)
# https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=

# --- OpenAI (Whisper-Transkription der Sprachnachricht) ----
# https://platform.openai.com -> API Keys
OPENAI_API_KEY=

# --- Meta WhatsApp Cloud API -------------------------------
# https://developers.facebook.com -> App -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Frei waehlbarer String - muss identisch in der Meta-Webhook-Konfiguration stehen
WHATSAPP_VERIFY_TOKEN=
# App-Secret aus Meta (App-Einstellungen -> Grundlegendes). Jede eingehende
# Webhook-Anfrage wird damit per Signatur geprueft. PFLICHT, mind. 16 Zeichen:
# ohne diesen Wert startet der Server nicht (Boot-Gate).
WHATSAPP_APP_SECRET=

# --- Feature-Flags (Maler-Umbau; alle standardmaessig AUS) ---
# FEATURE_VALIDATOR=
# FEATURE_PREISGEDAECHTNIS=
# FEATURE_ZUSAMMENFASSUNG=
# FEATURE_IMPORT=
# FEATURE_MALER_SCOPE=

# --- Oeffentlicher "Jetzt testen"-Aufnahmeknopf ------------
# Standardmaessig AUS. Zum Scharfschalten auf "true" setzen. Limits optional.
# WEBTEST_AKTIV=
# WEBTEST_MAX_PRO_IP=
# WEBTEST_MAX_PRO_TAG=
# WEBTEST_MAX_PRO_MONAT=
# WEBTEST_MIN_ABSTAND_SEKUNDEN=
# WEBTEST_MAX_AUDIO_MB=

# --- Test-Funktion "Direkt testen" (WhatsApp) --------------
# Unbekannte Nummer -> kostenloses Beispiel-Angebot. Standardmaessig AUS.
DIREKTTEST_AKTIV=
# Gratis-Angebote pro Nummer, danach Einladung zur Anmeldung
DIREKTTEST_GRATIS_ANGEBOTE=
# Harte Obergrenze verarbeiteter Nachrichten pro Nummer (Missbrauchsschutz)
DIREKTTEST_MAX_NACHRICHTEN=
# Tages-Gesamtdeckel ueber alle Nummern (Kostenobergrenze)
DIREKTTEST_MAX_PRO_TAG=
# Mindestabstand zwischen zwei Nachrichten derselben Nummer (Sekunden)
DIREKTTEST_MIN_ABSTAND_SEKUNDEN=
# Laenderkennungen (ohne +, Komma-getrennt), aus denen unbekannte Nummern ein Test-Konto bekommen. Standard: 49 (nur Deutschland).
DIREKTTEST_LAENDER=

# --- E-Mail-Versand (SMTP - IONOS, Strato, Gmail etc.) -----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cookie-Geheimnis fuer Geraete-Vertrauen und Betreiber-Login. PFLICHT, mind. 16
# Zeichen (z.B. openssl rand -hex 32): ohne diesen Wert startet der Server nicht.
SESSION_SECRET=
