{
  "name": "voiceprotokoll-guard",
  "version": "0.1.0",
  "description": "WhatsApp-Sprachnachricht → Protokoll-E-Mail + Archiv + Gewährleistungs-Tracking für Handwerker. Keine App, kein Login.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start:prod": "tsx src/server.ts",
    "dev:editor": "tsx src/web/devServer.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ki": "tsx src/test-ki.ts",
    "test:demo": "tsx src/test-demo.ts",
    "test:dialog": "tsx src/test-dialog.ts",
    "test:nachtrag": "tsx src/test-nachtrag.ts",
    "test:transkript": "tsx src/test-transkript.ts",
    "test:whisper": "tsx src/test-whisper.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "@fastify/multipart": "^10.1.0",
    "@prisma/client": "^6.19.3",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "js-yaml": "^4.3.1",
    "mammoth": "^1.12.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.48.0",
    "pdfkit": "^0.19.1",
    "stripe": "^22.5.0",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
