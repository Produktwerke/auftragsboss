// Angebotsblitz — Datenmodell
// SQLite für Dev; für Produktion provider auf "postgresql" ändern.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Der registrierte Handwerksbetrieb. Identifikation im WhatsApp-Alltag NUR
// über die Nummer — kein Passwort (Kernprinzip!). Für die Einstellungsseite
// (Logo, Adresse, Standardtexte, Angebotsübersicht) gibt es einen persönlichen
// Zufallslink: der einstellungenToken. Wer den Link hat, ist eingeloggt —
// derselbe passwortlose Ansatz wie bei den Dokument-Links.
model Handwerker {
  id             String     @id @default(cuid())
  whatsappNummer String     @unique // E.164, z.B. "4917612345678"
  name           String // Inhaber / Ansprechpartner
  firma          String
  email          String // Zieladresse für die fertigen Dokumente
  gewerk         String?

  // Explizites Gewerk als Domänenobjekt (Maler-Spezialisierung). Steuert, welche
  // Fachlogik/Ontologie greift. Start: "MALER". Bestehende Betriebe defaulten
  // migrationssicher auf MALER — das ist die aktuelle Produktausrichtung.
  gewerkTyp String @default("MALER")

  // Preisgedächtnis (opt-in): Nur wenn der Betrieb es wünscht, merkt sich
  // AuftragsBoss, wie er ähnliche Leistungen zuletzt kalkuliert hat, und schlägt
  // den Preis DATIERT vor. Standardmäßig aus — nie ungefragt.
  preisGedaechtnisAktiv Boolean @default(false)

  // Zusammenfassung vor dem Angebot ("das habe ich verstanden") per WhatsApp.
  // Standardmäßig AN — schafft Vertrauen. Der Betrieb kann sie dauerhaft
  // abschalten (Einstellungen oder Stichwort), sobald er dem System vertraut.
  zusammenfassungAktiv Boolean @default(true)

  // Betriebsprofil — jeder Betrieb hinterlegt seine eigenen Stammdaten über
  // die Einstellungsseite. Solange ein Feld leer ist, greift der Eintrag aus
  // preisliste.json als Vorgabe (Einzelbetrieb im Test).
  logoDatei String? // Pfad im uploads-Ordner, z.B. "uploads/logo_abc123.png"
  farbe     String? // Akzentfarbe als Hex ohne #, z.B. "0B5CAD"
  strasse   String? // Straße und Hausnummer (Briefkopf)
  plz       String?
  ort       String?
  telefon   String?
  ustIdNr   String? // für die Fußzeile
  bank      String? // Bankverbindung für die Fußzeile

  // Standardtexte, die der Betrieb auf jedem Angebot haben möchte —
  // z.B. eine feste Grußformel oder ein Haftungs-/Gewährleistungshinweis.
  standardEinleitung  String? // Vorgabe-Anschreiben, falls die KI keins bildet
  standardSchlusstext String? // wird an den Schlusstext jedes Angebots angehängt

  // Persönlicher, passwortloser Zugang zur Einstellungsseite. Nullable, damit
  // Bestandsdatensätze ohne Migration bestehen bleiben — der Token wird beim
  // ersten Bedarf erzeugt (siehe betrieb/betriebsdaten.ts).
  einstellungenToken String? @unique

  // Gesetzt, wenn der Handwerker per WhatsApp „Feedback" gesagt hat und wir auf
  // seine nächste Nachricht warten. Nur kurz gültig (siehe pipeline.ts).
  feedbackWartetSeit DateTime?

  // Empfehlungsprogramm ("Freundschaftswerbung"). werbeCode = persönlicher
  // Einladungslink. freimonate = verdiente Gratis-Monate (bei Abo einzulösen).
  werbeCode         String?  @unique
  empfehlungGenudgt Boolean  @default(false) // schon zum Einladen aufgefordert?
  freimonate        Int      @default(0)

  // Test-Funktion "Direkt testen": Schickt ein Interessent von der Landingpage
  // aus eine Sprachnachricht, wird seine (unbekannte) Nummer automatisch zu
  // einem Test-Konto. istTest trennt es von echten Kunden; testNachrichten
  // zählt die verarbeiteten Nachrichten als Kostenschutz (siehe direkttest.ts).
  istTest         Boolean @default(false)
  testNachrichten Int     @default(0)

  // Merkt sich den Haken "Angebot beim Export auch als E-Mail an mich senden"
  // aus dem Editor — bleibt gesetzt, bis der Handwerker ihn wieder abwählt.
  mailStandard Boolean @default(false)

  erstelltAm       DateTime           @default(now())
  dokumente        Dokument[]
  vorgaenge        Vorgang[]
  feedback         Feedback[]
  empfehlungen     Empfehlung[] // von diesem Betrieb geworbene Kollegen (Leads)
  preisGedaechtnis Preisgedaechtnis[]
  importDokumente  ImportDokument[]
}

// Eine Empfehlung: Ein Betrieb wirbt einen Kollegen. Erst als Lead erfasst
// (Kontaktdaten); Freischaltung + Gutschrift der Gratis-Monate erfolgt beim
// Aktivieren durch das Team (status OFFEN → AKTIVIERT).
model Empfehlung {
  id       String     @id @default(cuid())
  werberId String
  werber   Handwerker @relation(fields: [werberId], references: [id])

  firma          String
  name           String
  whatsappNummer String
  email          String?

  status     String   @default("OFFEN") // "OFFEN" | "AKTIVIERT"
  erstelltAm DateTime @default(now())

  @@index([werberId])
  @@index([status])
}

// Rückmeldungen der Handwerker — über die Einstellungsseite (quelle "WEB")
// oder per WhatsApp (quelle "WHATSAPP"). Bewusst schlicht: Text + Herkunft.
model Feedback {
  id           String     @id @default(cuid())
  handwerkerId String
  handwerker   Handwerker @relation(fields: [handwerkerId], references: [id])

  text   String
  quelle String // "WEB" | "WHATSAPP"

  erstelltAm DateTime @default(now())

  @@index([handwerkerId, erstelltAm])
}

// Ein laufender WhatsApp-Dialog. Bleibt offen, solange die KI noch
// Pflichtangaben vermisst — dann stellt sie Rückfragen, die der Handwerker
// per Sprache oder Text beantwortet. Abgeschlossen wird durch:
//   • Vollständigkeit    • Stichwort ("weiter", "später", "fertig")
//   • maximale Rundenzahl • Zeitablauf (Inaktivität)
model Vorgang {
  id           String     @id @default(cuid())
  handwerkerId String
  handwerker   Handwerker @relation(fields: [handwerkerId], references: [id])

  status String @default("OFFEN") // "OFFEN" | "ABGESCHLOSSEN"
  runde  Int    @default(0) // Anzahl bereits gestellter Rückfrage-Runden

  // Wurde in diesem Vorgang die Zusammenfassung "das habe ich verstanden" schon
  // gezeigt? Verhindert, dass sie sich bei jeder Antwort wiederholt.
  zusammenfassungGezeigt Boolean @default(false)

  // JSON: [{ rolle: "handwerker"|"assistent", text, art, zeit }]
  nachrichtenJson String @default("[]")

  dokumentId String? // gesetzt, sobald das Dokument erzeugt wurde

  begonnenAm       DateTime @default(now())
  letzteAktivitaet DateTime @default(now())

  @@index([handwerkerId, status])
  @@index([status, letzteAktivitaet])
}

// Ein Dokument aus einem Diktat — Angebot ODER Protokoll.
// Beides landet im selben Archiv: der Auftragszyklus eines Kunden
// bleibt so an einer Stelle nachvollziehbar.
model Dokument {
  id           String     @id @default(cuid())
  handwerkerId String
  handwerker   Handwerker @relation(fields: [handwerkerId], references: [id])

  art    String // "ANGEBOT" | "PROTOKOLL"
  nummer String // z.B. "ANG-2026-0042" bzw. "PRO-2026-0042"

  // Nachträge behalten die Angebotsnummer und zählen die Fassung hoch.
  // Die alte Fassung bleibt im Archiv — wichtig für die Nachvollziehbarkeit.
  version  Int     @default(1)
  ersetztId String? // Dokument-ID der vorherigen Fassung

  // Zwei getrennte Links, beide ohne Login (Zufallstoken).
  //   bearbeitenToken → der Handwerker, darf ändern und exportieren
  //   kundenToken     → der Kunde, sieht nur und kann annehmen
  bearbeitenToken String @unique
  kundenToken     String @unique

  // Annahme durch den Kunden. Ein Klick auf "Annehmen" ist ein Vertrags-
  // schluss, deshalb wird der Vorgang beweissicher festgehalten und das
  // Dokument danach eingefroren (Änderungen erzeugen eine neue Fassung).
  angenommenAm   DateTime?
  angenommenVon  String? // Name, den der Kunde angegeben hat
  angenommenIp   String?
  eingefroren    Boolean   @default(false)

  // Vom Handwerker selbst als "versendet" markiert → schreibgeschützt
  // (ansehen ja, ändern nein). Jederzeit wieder aufhebbar; dann editierbar.
  versendetAm    DateTime?

  // Rückfragen des Kunden über die Angebotsseite
  kundenRueckfrage   String?
  kundenRueckfrageAm DateTime?

  // Rohdaten — bewusst aufbewahrt (Nachvollziehbarkeit / Streitfall)
  whatsappMediaId String?
  transkript      String // Whisper-Rohtranskript, unverändert

  // Strukturierte Daten (von Claude extrahiert)
  kundeName      String?
  kundeStrasse   String? // Straße und Hausnummer
  kundePlzOrt    String? // PLZ und Ort
  kundenNummer   String? // interne Kundennummer des Betriebs, frei editierbar
  gewerk         String?
  objekt         String?
  positionenJson String // JSON: berechnete Positionen inkl. Preise (editierbar)
  // Momentaufnahme dessen, was die KI ANFANGS erkannt hat — wird nie geändert.
  // Vergleich mit dem finalen Stand zeigt, wo die KI danebenlag ("Lernen").
  kiOriginalJson String? // JSON: { positionen, kunde{}, objekt, einleitung, schlusstext }
  aufmassNotizen String?
  besonderheiten String?
  folgetermin    String?
  einleitung     String
  schlusstext    String
  rueckfragenJson String @default("[]")

  // Summen — im Code berechnet, nicht von der KI
  netto       Float
  mwstSatz    Float
  mwstBetrag  Float
  brutto      Float
  anzahlOffen Int     @default(0) // Positionen ohne Preis
  gueltigBis  DateTime?

  datum      DateTime @default(now())
  erstelltAm DateTime @default(now())

  gewaehrleistung Gewaehrleistung?

  @@index([handwerkerId, datum])
  @@index([art])
  @@index([nummer])
  @@index([angenommenAm])
}

// Preisgedächtnis (opt-in je Betrieb): AuftragsBoss merkt sich, wie DIESER
// Betrieb ähnliche Leistungen bisher kalkuliert hat, und schlägt den Preis beim
// nächsten Mal DATIERT vor. Kein Preisbuch, das gepflegt werden müsste — es lernt
// aus der tatsächlichen Nutzung. Streng pro Betrieb (handwerkerId), nie global,
// nie automatisch gesetzt, nie erfunden: Es ist immer ein Preis, den der Betrieb
// SELBST schon einmal eingetragen hat.
model Preisgedaechtnis {
  id           String     @id @default(cuid())
  handwerkerId String
  handwerker   Handwerker @relation(fields: [handwerkerId], references: [id])

  // Normalisierter Schlüssel aus Beschreibung + Einheit, um ähnliche Leistungen
  // wiederzuerkennen (z.B. "wand streichen|m2"). Bewusst simpel für Phase 1;
  // später ersetzbar durch Ähnlichkeitssuche über die Positionsbibliothek.
  leistungSchluessel String
  beschreibung       String // Originalbeschreibung, wie zuletzt verwendet
  einheit            String?

  letzterPreis Float
  zuletztAm    DateTime @default(now()) // Datum des zuletzt bestätigten Preises
  quelle       String   @default("EDITOR") // "EDITOR" | "IMPORT"

  erstelltAm DateTime @default(now())

  @@unique([handwerkerId, leistungSchluessel])
  @@index([handwerkerId])
}

// Minimales Event-Tracking für Produktmetriken (Aktivierung/Qualität/Bindung).
// Datensparsam: Typ + optionaler Betriebsbezug + wenige strukturierte Felder als
// JSON. KEINE Kundennamen oder Freitexte. Grundlage fürs spätere Dashboard.
// Bewusst OHNE Relation (handwerkerId als reiner String), damit auch Ereignisse
// ohne Betriebsbezug (z.B. anonyme Landingpage-Aktion) erfasst werden können.
model Event {
  id           String  @id @default(cuid())
  typ          String // z.B. "ANGEBOT_ERSTELLT", "RUECKFRAGE", "IMPORT_START"
  handwerkerId String? // null bei Ereignissen ohne Betriebsbezug
  dataJson     String  @default("{}")

  erstelltAm DateTime @default(now())

  @@index([typ, erstelltAm])
  @@index([handwerkerId])
}

// ── Maler-Fachengine v1: Altangebots-Import ────────────────────────────────
// Ein hochgeladenes Alt-Angebot eines Betriebs. STRENG pro handwerkerId; beim
// Löschen des Betriebs/Dokuments kaskadieren die extrahierten Positionen mit.
// Rohdaten und abstrahierte Daten bleiben so an einer Stelle löschbar (DSGVO).
model ImportDokument {
  id           String     @id @default(cuid())
  handwerkerId String
  handwerker   Handwerker @relation(fields: [handwerkerId], references: [id], onDelete: Cascade)

  originalDateiname String
  dokumentDatum     DateTime?
  angebotsnummer    String?
  kundeReferenz     String? // pseudonym/optional, Datensparsamkeit
  objektReferenz    String?

  waehrung     String  @default("EUR")
  mwstSatz     Float?
  nettoSumme   Float?
  mwstSumme    Float?
  bruttoSumme  Float?
  zahlungsziel String?
  gueltigkeit  String?
  einleitung   String? // introduction_text
  schlusstext  String? // closing_text
  ausschluesse String? // JSON-Liste erkannter Ausschlüsse

  // Dokumentqualität — OCR NIE still als sicher behandeln.
  extraktionsMethode     String  @default("text") // "text" | "ocr"
  extraktionsKonfidenz   String  @default("unknown") // "high"|"medium"|"low"|"unknown"
  manuellePruefungNoetig Boolean @default(false)
  seitenzahl             Int?

  status     String   @default("IMPORTIERT") // IMPORTIERT | BESTAETIGT | ABGELEHNT
  erstelltAm DateTime @default(now())

  positionen ImportPosition[]

  @@index([handwerkerId, erstelltAm])
  @@index([status])
}

// Eine aus einem Alt-Angebot extrahierte Position. handwerkerId ist bewusst
// denormalisiert dabei, damit JEDE Abfrage direkt nach Tenant filtern kann.
// Unbekannte Felder bleiben null; nichts wird aus Preis/Text rekonstruiert.
model ImportPosition {
  id               String         @id @default(cuid())
  handwerkerId     String
  importDokumentId String
  importDokument   ImportDokument @relation(fields: [importDokumentId], references: [id], onDelete: Cascade)

  quelleSeite          Int?
  originalNummer       String?
  originalTitel        String
  originalBeschreibung String?
  normalisierterTyp    String? // position_id aus positions.yaml oder null

  menge             Float?
  einheit           String?
  einzelpreis       Float?
  gesamtpreis       Float?
  materialEnthalten Boolean? // null = unbekannt
  arbeitEnthalten   Boolean?

  kontextJson          String  @default("{}") // context_features (Bauteil, Untergrund …)
  extraktionsKonfidenz String  @default("unknown")
  manuellBestaetigt    Boolean @default(false)
  erstelltAm           DateTime @default(now())

  @@index([handwerkerId])
  @@index([importDokumentId])
  @@index([handwerkerId, normalisierterTyp])
}

// Gewährleistungs-Tracking nach § 634a BGB — nur für Protokolle:
//   - 2 Jahre für Werkleistungen (Standard)
//   - 5 Jahre für Arbeiten an Bauwerken
// Erinnerung 3 Monate vor Ablauf = Wartungs-Verkaufschance,
// Erinnerung bei Ablauf = Haftungsende dokumentiert.
model Gewaehrleistung {
  id         String   @id @default(cuid())
  dokumentId String   @unique
  dokument   Dokument @relation(fields: [dokumentId], references: [id])

  typ    String // "WERK_2_JAHRE" | "BAUWERK_5_JAHRE"
  beginn DateTime
  ablauf DateTime
  vorwarnung DateTime

  vorwarnungGesendet Boolean @default(false)
  ablaufGesendet     Boolean @default(false)

  @@index([vorwarnung, vorwarnungGesendet])
  @@index([ablauf, ablaufGesendet])
}
